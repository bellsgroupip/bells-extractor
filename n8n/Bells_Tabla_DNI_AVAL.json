      "id": "n1-trigger",
      "name": "Mail AVALES",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "0MiUFbBH1vITLbea",
          "name": "automatizacionesbg@gmail.com"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// El trigger de Gmail (con \"Download Attachments\" activado) trae los\n// adjuntos como propiedades binarias del mismo item -- uno por archivo.\n// Los separamos en items individuales y clasificamos cada uno por nombre\n// de archivo (mismo criterio que \"Clasificar Archivos\" del workflow de\n// Revisión de Solicitud). Los que no son ni DNI ni AVAL se ignoran -- no\n// se sabe qué hacer con ellos en este workflow.\nconst items = [];\nfor (const item of $input.all()) {\n  for (const key of Object.keys(item.binary || {})) {\n    const binario = item.binary[key];\n    const nombre = binario.fileName || key;\n    let tipo = null;\n    if (/\\bdni\\b/i.test(nombre)) tipo = 'dni';\n    else if (/\\baval\\b/i.test(nombre)) tipo = 'aval';\n    if (!tipo) continue;\n    items.push({\n      json: { fileName: nombre, tipo },\n      binary: { data: binario },\n    });\n  }\n}\nreturn items;\n"
      },
      "id": "n2-separar",
      "name": "Separar y Clasificar Adjuntos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://bells-extractor:8000/extract",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "jCyx1JWFumNmPGi_jQoeamrVbwwQBPq0WmCzQulTOpg"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "tipo",
              "value": "={{ $json.tipo }}"
            },
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            }
          ]
        },
        "options": {}
      },
      "id": "n3-extraer",
      "name": "Extraer Datos (Servicio)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        512,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const original = $('Separar y Clasificar Adjuntos').item.json;\nconst tipo = original.tipo;\nconst respuesta = $input.item.json;\nlet datosExtraidos;\n\nif (respuesta.error) {\n  datosExtraidos = {\n    errorExtraccion: `No se pudieron extraer los datos del documento \"${tipo}\": ${JSON.stringify(respuesta.error)}`,\n  };\n} else {\n  datosExtraidos = respuesta.campos;\n}\n\nreturn { json: { ...original, datosExtraidos } };\n"
      },
      "id": "n4-procesar",
      "name": "Procesar Respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        768,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-tipo-dni",
              "leftValue": "={{ $json.tipo === 'dni' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n5-if",
      "name": "Es DNI?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1024,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Fila para la pestaña \"DNI\": Nombre | Apellido | Fecha de Nacimiento |\n// Lugar de Nacimiento | N° de DNI | N° de CUIT/CUIL | Archivo | Fecha de carga\nconst c = $json.datosExtraidos || {};\n\nreturn [{\n  json: {\n    values: [[\n      c['DNI - Nombre'] || '',\n      c['DNI - Apellido'] || '',\n      c['DNI - Fecha de nacimiento'] || '',\n      c['DNI - Lugar de nacimiento'] || '',\n      c['DNI - Documento N°'] || '',\n      c['DNI - CUIL'] || '',\n      $json.fileName || '',\n      new Date().toISOString(),\n    ]],\n  },\n}];\n"
      },
      "id": "n6-mapear-dni",
      "name": "Mapear Fila DNI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "// Fila para la pestaña \"AVAL\": Razón Social / Nombre y Apellido | CUIT/CUIL |\n// Domicilio | Provincia | Localidad | Código Postal | Archivo | Fecha de carga\nconst c = $json.datosExtraidos || {};\nconst domicilio = [c['AVAL - Calle'], c['AVAL - Número']].filter(Boolean).join(' ');\n\nreturn [{\n  json: {\n    values: [[\n      c['AVAL - Nombre y Apellido / Razón Social'] || '',\n      c['AVAL - CUIT'] || '',\n      domicilio,\n      c['AVAL - Provincia'] || '',\n      c['AVAL - Localidad'] || '',\n      c['AVAL - Código Postal'] || '',\n      $json.fileName || '',\n      new Date().toISOString(),\n    ]],\n  },\n}];\n"
      },
      "id": "n7-mapear-aval",
      "name": "Mapear Fila AVAL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        432
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/15n_YooFxFBoGjbrJlBFq7nZwF5VcoEeVe8OPlxeJvxE/values/DNI!A1:append",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "valueInputOption",
              "value": "RAW"
            },
            {
              "name": "insertDataOption",
              "value": "INSERT_ROWS"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { values: $json.values } }}",
        "options": {}
      },
